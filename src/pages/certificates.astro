---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { withBase } from "@/lib/utils";

interface Certificate {
  name: string;
  issuer: string;
  // Verification URL. Without one, the item renders as plain text.
  url?: string;
  // Optional certificate image, e.g. "/certificates/technical-support-fundamentals.jpg".
  // Files go in /public/certificates/.
  image?: string;
}

// Each item links to its Coursera verification page. Images are the
// certificate PDFs, exported to /public/certificates/.
const CERTIFICATES: Certificate[] = [
  {
    name: "Technical Support Fundamentals",
    issuer: "Google, Coursera · Nov 6, 2026",
    url: "https://coursera.org/verify/HEOHHE2Z755F",
    image: "/certificates/technical-support-fundamentals.jpg",
  },
  {
    name: "The Bits and Bytes of Computer Networking",
    issuer: "Google, Coursera · Nov 8, 2026",
    url: "https://coursera.org/verify/7HCWO6EN7TC5",
    image: "/certificates/bits-and-bytes-of-computer-networking.jpg",
  },
  {
    name: "Operating Systems and You: Becoming a Power User",
    issuer: "Google, Coursera · Nov 8, 2026",
    url: "https://coursera.org/verify/JGQVWQ9A7TIV",
    image: "/certificates/operating-systems-and-you.jpg",
  },
  {
    name: "System Administration and IT Infrastructure Services",
    issuer: "Google, Coursera · Nov 12, 2026",
    url: "https://coursera.org/verify/I4A9G5BSDMWK",
    image: "/certificates/system-administration-it-infrastructure.jpg",
  },
  {
    name: "IT Security: Defense Against the Digital Dark Arts",
    issuer: "Google, Coursera · Nov 7, 2026",
    url: "https://coursera.org/verify/J0G1HTWAVAD8",
    image: "/certificates/it-security.jpg",
  },
  {
    name: "Accelerate Your Job Search with AI",
    issuer: "Google, Coursera · Nov 7, 2026",
    url: "https://coursera.org/verify/Q9U3XN9M6HGH",
    image: "/certificates/accelerate-job-search-with-ai.jpg",
  },
];

const GROUPS = [
  {
    title: "Google courses on Coursera",
    intro:
      "Google IT Support course series, completed November 2026. The overall Google IT Support Professional Certificate is pending issuance.",
    items: CERTIFICATES,
  },
];
---

<Layout title="Certificates" description="Google IT Support course series and Google career courses on Coursera, with verification links.">
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">Certificates</h1>

    {GROUPS.map((group) => (
      <div class="mt-12">
        <h2 class="text-xs font-medium uppercase tracking-widest text-muted-foreground">{group.title}</h2>
        {group.intro && <p class="mt-3 max-w-xl text-muted-foreground">{group.intro}</p>}
        <div class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2">
          {group.items.map((cert) => {
            const content = (
              <>
                {cert.image && (
                  <img src={withBase(cert.image)} alt={`${cert.name} certificate`} class="mb-4 w-full rounded-lg border border-border" loading="lazy" />
                )}
                <span class="font-medium text-foreground">{cert.name}</span>
                <p class="mt-1 text-sm text-muted-foreground">{cert.issuer}</p>
                {cert.url && <span class="mt-3 inline-flex text-sm font-medium text-foreground">Verify &rarr;</span>}
              </>
            );
            return cert.url ? (
              <a href={cert.url} target="_blank" rel="noopener noreferrer" class="flex flex-col bg-background p-5 hover:bg-muted transition-colors">
                {content}
              </a>
            ) : (
              <div class="flex flex-col bg-background p-5">{content}</div>
            );
          })}
        </div>
      </div>
    ))}
  </section>
</Layout>
